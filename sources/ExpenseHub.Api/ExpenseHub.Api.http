@ExpenseHub_Api_HostAddress = http://localhost:5245
@adminEmail = admin@expensehub.local
@adminPassword = <senha configurada no user-secrets>

GET {{ExpenseHub_Api_HostAddress}}/health
Accept: application/json

###

# I02 - login válido: retorna accessToken
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###

# I02 - senha incorreta: 401
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "errada"
}

###

# I02 - corpo inválido: 400
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{}

###

# I03 - cadastro público: 201, usuário criado sem nenhuma role
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "ana@empresa.com",
  "password": "Senha#123"
}

###

# I03 - role enviada no cadastro é ignorada: usuário continua sem roles
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "bia@empresa.com",
  "password": "Senha#123",
  "roles": ["Admin"]
}

###

# Cole aqui o accessToken retornado pelo login do Admin
@adminToken = <accessToken do Admin>

# I03 - listar usuários: 200 como Admin, 401 sem token, 403 sem a role Admin
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{adminToken}}

###

# Cole aqui o id de um usuário retornado pela listagem
@userId = <id do usuário>

# I03 - substituir as roles do usuário: 200
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{userId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Employee", "Approver"]
}

###

# I03 - role desconhecida: 400
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{userId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["SuperUser"]
}

###

# I03 - usuário inexistente: 404
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/nao-existe/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Employee"]
}

###

# Cole aqui o accessToken de um usuário com a role Employee
@employeeToken = <accessToken do Employee>

# I04 - criar rascunho: 201, estado Draft, proprietário obtido do token
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente",
  "amount": 120.50,
  "expenseDate": "2026-09-30",
  "categoryId": 1
}

###

# I04 - campos controlados pelo servidor são ignorados: continua Draft e do próprio usuário
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente",
  "amount": 120.50,
  "expenseDate": "2026-09-30",
  "categoryId": 1,
  "ownerId": "outro-usuario",
  "status": "Paid"
}

###

# I04 - valor fora do limite, descrição curta e data futura: 400
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "curta",
  "amount": 0,
  "expenseDate": "2099-01-01",
  "categoryId": 1
}

###

# Cole aqui o id retornado na criação
@expenseId = <id do reembolso>

# I04 - editar rascunho próprio: 200 (outro usuário: 404; fora de Draft: 409)
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente e equipe",
  "amount": 180.00,
  "expenseDate": "2026-09-30",
  "categoryId": 1
}

###

# I05 - enviar rascunho próprio: 200 (repetido ou fora de Draft: 409; de outro usuário: 404)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{employeeToken}}

###

# I05 - listar conforme o perfil do token:
# Employee: próprios | Approver: Submitted | Finance: Approved e Paid | Auditor: todos | Admin puro: 403
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}

###

# I05 - detalhe: 200 se visível para o perfil; 404 se inexistente ou fora do escopo
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeToken}}
