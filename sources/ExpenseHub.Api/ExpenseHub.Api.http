@ExpenseHub_Api_HostAddress = http://localhost:5245
@adminEmail = admin@expensehub.local
@adminPassword = <senha configurada no user-secrets>

GET {{ExpenseHub_Api_HostAddress}}/health
Accept: application/json

###

# I02 - login válido: retorna accessToken
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###

# I02 - senha incorreta: 401
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "errada"
}

###

# I02 - corpo inválido: 400
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{}

###

# I03 - cadastro público: 201, usuário criado sem nenhuma role
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "ana@empresa.com",
  "password": "Senha#123"
}

###

# I03 - role enviada no cadastro é ignorada: usuário continua sem roles
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "bia@empresa.com",
  "password": "Senha#123",
  "roles": ["Admin"]
}

###

# Cole aqui o accessToken retornado pelo login do Admin
@adminToken = <accessToken do Admin>

# I03 - listar usuários: 200 como Admin, 401 sem token, 403 sem a role Admin
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{adminToken}}

###

# Cole aqui o id de um usuário retornado pela listagem
@userId = <id do usuário>

# I03 - substituir as roles do usuário: 200
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{userId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Employee", "Approver"]
}

###

# I03 - role desconhecida: 400
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{userId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["SuperUser"]
}

###

# I03 - usuário inexistente: 404
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/nao-existe/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Employee"]
}

###

# Cole aqui o accessToken de um usuário com a role Employee
@employeeToken = <accessToken do Employee>

# I04 - criar rascunho: 201, estado Draft, proprietário obtido do token
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente",
  "amount": 120.50,
  "expenseDate": "2026-09-30",
  "categoryId": 1
}

###

# I04 - campos controlados pelo servidor são ignorados: continua Draft e do próprio usuário
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente",
  "amount": 120.50,
  "expenseDate": "2026-09-30",
  "categoryId": 1,
  "ownerId": "outro-usuario",
  "status": "Paid"
}

###

# I04 - valor fora do limite, descrição curta e data futura: 400
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "curta",
  "amount": 0,
  "expenseDate": "2099-01-01",
  "categoryId": 1
}

###

# Cole aqui o id retornado na criação
@expenseId = <id do reembolso>

# I04 - editar rascunho próprio: 200 (outro usuário: 404; fora de Draft: 409)
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente e equipe",
  "amount": 180.00,
  "expenseDate": "2026-09-30",
  "categoryId": 1
}

###

# I05 - enviar rascunho próprio: 200 (repetido ou fora de Draft: 409; de outro usuário: 404)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{employeeToken}}

###

# I05 - listar conforme o perfil do token:
# Employee: próprios | Approver: Submitted | Finance: Approved e Paid | Auditor: todos | Admin puro: 403
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}

###

# I05 - detalhe: 200 se visível para o perfil; 404 se inexistente ou fora do escopo
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeToken}}

###

# I06 - matriz de acesso com várias identidades.
# Preparação: cadastre os usuários em /register, atribua as roles como Admin
# (PUT /api/admin/users/{id}/roles) e faça login de novo com cada um.
# {{employeeToken}} é o Employee A, dono de {{expenseId}}.
@employeeBToken = <accessToken do Employee B>
@approverToken = <accessToken do Approver>
@financeToken = <accessToken do Finance>
@auditorToken = <accessToken do Auditor>
@noRoleToken = <accessToken de usuário sem role>

# I06 - sem token: 401
GET {{ExpenseHub_Api_HostAddress}}/api/expenses

###

# I06 - autenticado sem role: 403
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{noRoleToken}}

###

# I06 - Admin sem outra role não tem acesso funcional: 403
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{adminToken}}

###

# I06 - Employee B lista: só os próprios, nunca os do Employee A
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeBToken}}

###

# I06 - Employee B trocando o id na URL para o reembolso do Employee A: 404
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeBToken}}

###

# I06 - Employee B editando o reembolso do Employee A: 404 (mesmo com categoria inválida)
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeBToken}}
Content-Type: application/json

{
  "description": "Tentativa de edição alheia",
  "amount": 1.00,
  "expenseDate": "2026-09-30",
  "categoryId": 9999
}

###

# I06 - Employee B enviando o reembolso do Employee A: 404
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{employeeBToken}}

###

# I06 - Approver lista: somente Submitted (Draft alheio: 404 no detalhe)
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{approverToken}}

###

# I06 - Approver sem Employee não cria reembolso: 403
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "description": "Approver tentando criar",
  "amount": 10.00,
  "expenseDate": "2026-09-30",
  "categoryId": 1
}

###

# I06 - Finance lista: somente Approved e Paid
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{financeToken}}

###

# I06 - Finance consultando reembolso Draft ou Submitted: 404
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{financeToken}}

###

# I06 - Auditor lista: todos
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{auditorToken}}

###

# I06 - Auditor não escreve: 403
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{auditorToken}}

###

# I07 - aprovar reembolso Submitted de outro usuário: 200, estado Approved
# (Draft: 404; repetição ou já decidido: 409; Employee, Finance, Auditor ou Admin: 403)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/approve
Authorization: Bearer {{approverToken}}

###

# I07 - reprovar com justificativa (10 a 500): 200, estado Rejected
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/reject
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "justification": "Comprovante ilegível e sem CNPJ."
}

###

# I07 - justificativa curta, vazia ou ausente: 400
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/reject
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "justification": "curta"
}

###

# Cole aqui o accessToken de um usuário com Employee + Approver, dono de {{ownExpenseId}} (Submitted)
@employeeApproverToken = <accessToken do Employee + Approver>
@ownExpenseId = <id de um reembolso Submitted do próprio usuário>

# I07 - Approver não aprova o próprio reembolso: 403
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{ownExpenseId}}/approve
Authorization: Bearer {{employeeApproverToken}}

###

# I07 - Approver não reprova o próprio reembolso: 403
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{ownExpenseId}}/reject
Authorization: Bearer {{employeeApproverToken}}
Content-Type: application/json

{
  "justification": "Tentativa de reprovar o próprio reembolso."
}

###

# I08 - pagar reembolso Approved de outro usuário: 200, estado Paid
# (Draft: 404; Submitted, Rejected ou já Paid: 409; proprietário: 403; sem role Finance: 403)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{financeToken}}

###

# I08 - pagamento repetido: 409, sem novo histórico nem novo registro de pagamento
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{financeToken}}

###

# I08 - histórico em ordem cronológica, com a mesma visibilidade do reembolso:
# Employee: próprio | Approver: Submitted | Finance: Approved e Paid | Auditor: todos
# Fora do escopo ou inexistente: 404 | Admin puro: 403
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/history
Authorization: Bearer {{employeeToken}}

###

# I08 - Auditor consulta o histórico de qualquer reembolso: 200
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/history
Authorization: Bearer {{auditorToken}}

###

# I08 - Auditor não paga: 403
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{auditorToken}}
